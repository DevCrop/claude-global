{
  "model": "sonnet",
  "effortLevel": "high",
  "advisorModel": "opus",
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"[\\(.model.display_name)] \\(.context_window.used_percentage // 0)% context\"'"
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf %USERPROFILE%*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -fr $HOME*)",
      "Bash(rm -fr %USERPROFILE%*)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -fdx *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git restore --staged .)",
      "Read(**/.credentials*)",
      "Read(**/.env*)",
      "Read(**/credentials.json)",
      "Bash(rtk rm -rf /*)",
      "Bash(rtk rm -rf ~*)",
      "Bash(rtk rm -rf $HOME*)",
      "Bash(rtk rm -rf %USERPROFILE%*)",
      "Bash(rtk rm -fr /*)",
      "Bash(rtk rm -fr ~*)",
      "Bash(rtk rm -fr $HOME*)",
      "Bash(rtk rm -fr %USERPROFILE%*)",
      "Bash(rtk git push --force *)",
      "Bash(rtk git push --force)",
      "Bash(rtk git push -f *)",
      "Bash(rtk git push -f)",
      "Bash(rtk git push * --force)",
      "Bash(rtk git push * --force *)",
      "Bash(rtk git push * -f)",
      "Bash(rtk git push * -f *)",
      "Bash(rtk git reset --hard *)",
      "Bash(rtk git reset --hard)",
      "Bash(rtk git clean -f *)",
      "Bash(rtk git clean -fd *)",
      "Bash(rtk git clean -fdx *)",
      "Bash(rtk git checkout -- *)",
      "Bash(rtk git checkout .)",
      "Bash(rtk git restore .)",
      "Bash(rtk git restore --staged .)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
